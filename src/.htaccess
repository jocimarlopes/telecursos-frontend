# Fallback de rota para aplicação de página única (Apache / Hostinger).
#
# Sem isto, abrir cursando.pro/meus-cursos direto — ou dar refresh — devolve
# 404: o servidor procura uma pasta com esse nome. O roteamento do Angular só
# existe depois que o index.html carrega.
#
# Vale especialmente para /validar/<codigo>: é o endereço impresso no QR Code
# dos certificados, e quem escaneia chega nele sem passar pela home.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivo ou pasta que existe de verdade é servido normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outro caminho entrega o index.html e o Angular resolve a rota
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Os arquivos com hash no nome podem ser cacheados para sempre;
  # o index.html nunca, senão o navegador serve uma versão velha do app.
  <FilesMatch "\.(js|css|woff2?|ttf|png|jpg|jpeg|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
